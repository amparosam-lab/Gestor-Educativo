      "resumen_simple": "Para medir cosas usamos unidades. Para medir longitudes usamos metros y centímetros, para pesar usamos kilos y gramos, y para líquidos usamos litros.",
      "conceptos_clave": ["kilómetro", "metro", "centímetro", "milímetro", "kilogramo", "gramo", "litro", "mililitro", "conversión de unidades"],
      "habilidades": ["usar el metro y sus divisiones", "usar el kilogramo y sus divisiones", "usar el litro y sus divisiones", "convertir unidades", "resolver problemas de medida"],
      "repaso_clave": [
