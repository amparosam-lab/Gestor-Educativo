          "variables": {
            "a": { "tipo": "numero", "min": 10, "max": 99 },
            "b": { "tipo": "numero", "min": 2, "max": 9 }
          },
          "respuesta": "a * b",
          "dificultad": "facil"
        },
        {
          "tipo": "doble_triple",
          "enunciado": "¿Cuánto es el {operacion} de {n}?",
          "variables": {
            "n": { "tipo": "numero", "min": 10, "max": 999 },
            "operacion": { "tipo": "lista", "opciones": ["doble", "triple"] }
          },
          "respuesta": "operacion == doble ? n*2 : n*3",
