        }
      ]
    },
    {
      "id_unidad": "mat_04",
      "numero": 4,
      "titulo": "División",
      "resumen": "Estudiamos la división exacta e inexacta, los términos de la división (dividendo, divisor, cociente y resto) y resolvemos problemas con divisiones.",
      "resumen_simple": "Dividir es repartir en partes iguales. Si tienes 20 caramelos y los quieres repartir entre 4 amigos, ¡con la división sabrás cuántos le tocan a cada uno!",
      "conceptos_clave": ["dividendo", "divisor", "cociente", "resto", "división exacta", "división inexacta", "prueba de la división"],
      "habilidades": ["dividir por una cifra", "calcular el resto", "comprobar divisiones", "resolver problemas de reparto"],
      "repaso_clave": [
        "División exacta: el resto es 0",
        "División inexacta: el resto es distinto de 0",
        "El resto siempre es menor que el divisor",
        "Prueba: cociente × divisor + resto = dividendo"
      ],
      "ejercicios_templates": [
        {
          "tipo": "division_exacta",
          "enunciado": "{a} ÷ {b} = ___",
          "variables": {
            "b": { "tipo": "numero", "min": 2, "max": 9 },
            "cociente": { "tipo": "numero", "min": 2, "max": 99 }
          },
          "a_calculo": "b * cociente",
          "respuesta": "a / b",
          "dificultad": "facil"
        },
        {
          "tipo": "division_con_resto",
          "enunciado": "{a} ÷ {b} = ___ (resto ___)",
          "variables": {
            "a": { "tipo": "numero", "min": 20, "max": 999 },
            "b": { "tipo": "numero", "min": 2, "max": 9 }
          },
          "respuesta": "cociente=floor(a/b), resto=a%b",
          "dificultad": "medio"
        },
        {
          "tipo": "prueba_division",
          "enunciado": "Comprueba la división: {dividendo} ÷ {divisor} = {cociente} (resto {resto}). ¿Es correcta?",
          "variables": {
            "divisor": { "tipo": "numero", "min": 2, "max": 9 },
            "cociente": { "tipo": "numero", "min": 10, "max": 99 },
            "resto": { "tipo": "numero", "min": 0, "max": 8 }
          },
          "dividendo_calculo": "divisor * cociente + resto",
          "respuesta": "divisor * cociente + resto == dividendo",
          "dificultad": "dificil"
        },
        {
          "tipo": "problema_reparto",
          "enunciado": "Hay {total} manzanas para repartir entre {personas} personas. ¿Cuántas le tocan a cada una? ¿Sobra alguna?",
          "variables": {
            "total": { "tipo": "numero", "min": 20, "max": 200 },
            "personas": { "tipo": "numero", "min": 2, "max": 9 }
          },
          "respuesta": "cociente=floor(total/personas), resto=total%personas",
          "dificultad": "medio"
        }
      ],
      "test_templates": [
        {
          "tipo": "test_division",
          "enunciado": "¿Cuánto es {a} ÷ {b}?",
          "variables": {
            "b": { "tipo": "numero", "min": 2, "max": 9 },
            "cociente": { "tipo": "numero", "min": 2, "max": 10 }
          },
          "a_calculo": "b * cociente",
          "respuesta": "cociente",
          "dificultad": "facil"
        }
      ],
      "actividades_templates": [
        {
          "tipo": "problema_grupos",
          "enunciado": "En el cole hay {alumnos} alumnos. Si se forman grupos de {grupo_size}, ¿cuántos grupos completos hay? ¿Cuántos alumnos sobran?",
          "variables": {
            "alumnos": { "tipo": "numero", "min": 50, "max": 200 },
            "grupo_size": { "tipo": "numero", "min": 4, "max": 8 }
          },
          "respuesta": "grupos=floor(alumnos/grupo_size), sobran=alumnos%grupo_size",
          "dificultad": "medio"
        }
      ],
      "fichas_templates": []
    },
