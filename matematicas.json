  "unidades": [
    {
      "id_unidad": "mat_01",
      "numero": 1,
      "titulo": "Números hasta el millón",
      "resumen": "En esta unidad aprendemos a leer, escribir y comparar números grandes hasta el millón. Trabajamos con el valor posicional de cada cifra y representamos cantidades en distintos formatos.",
      "resumen_simple": "Vamos a aprender a contar números muy grandes, ¡hasta un millón! Aprenderás a leer y escribir esos números y a saber cuánto vale cada cifra.",
      "conceptos_clave": ["valor posicional", "centenas de millar", "decenas de millar", "unidades de millar", "centenas", "decenas", "unidades", "descomposición numérica"],
      "habilidades": ["leer y escribir números hasta el millón", "ordenar y comparar números", "descomponer números", "identificar el valor posicional"],
      "repaso_clave": [
        "Un millón = 1.000.000",
        "Orden de posiciones: U, D, C, Um, Dm, Cm",
        "Para comparar: empieza por la cifra de mayor valor",
        "La descomposición separa cada cifra por su valor"
      ],
      "ejercicios_templates": [
        {
          "tipo": "valor_posicional",
          "enunciado": "¿Cuánto vale el {digito} en el número {numero}?",
          "variables": {
            "numero": { "tipo": "numero", "min": 10000, "max": 999999 },
            "digito": { "tipo": "lista", "opciones": ["primer dígito", "segundo dígito", "tercer dígito"] }
          },
          "respuesta": "calcular_valor_posicional(numero, digito)",
          "dificultad": "medio"
        },
        {
          "tipo": "escritura_numero",
          "enunciado": "Escribe con cifras: {numero_texto}",
          "variables": {
            "numero_texto": { "tipo": "numero_en_texto", "min": 1000, "max": 99999 }
          },
          "respuesta": "texto_a_numero(numero_texto)",
          "dificultad": "facil"
        },
        {
          "tipo": "comparacion",
          "enunciado": "¿Es {a} mayor, menor o igual que {b}? Escribe >, < o =",
          "variables": {
            "a": { "tipo": "numero", "min": 1000, "max": 99999 },
            "b": { "tipo": "numero", "min": 1000, "max": 99999 }
          },
          "respuesta": "comparar(a, b)",
          "dificultad": "facil"
        },
        {
          "tipo": "descomposicion",
          "enunciado": "Descompón el número {n}: ___ + ___ + ___ + ___ = {n}",
          "variables": {
            "n": { "tipo": "numero", "min": 10000, "max": 99999 }
          },
          "respuesta": "descomponer(n)",
          "dificultad": "medio"
        },
        {
          "tipo": "ordenar_numeros",
          "enunciado": "Ordena de menor a mayor: {a}, {b}, {c}, {d}",
          "variables": {
            "a": { "tipo": "numero", "min": 10000, "max": 999999 },
            "b": { "tipo": "numero", "min": 10000, "max": 999999 },
            "c": { "tipo": "numero", "min": 10000, "max": 999999 },
            "d": { "tipo": "numero", "min": 10000, "max": 999999 }
          },
          "respuesta": "ordenar([a,b,c,d])",
          "dificultad": "medio"
        },
        {
          "tipo": "antecesor_sucesor",
          "enunciado": "Escribe el antecesor y el sucesor de {n}",
          "variables": {
            "n": { "tipo": "numero", "min": 10001, "max": 999998 }
          },
          "respuesta": "antecesor=n-1, sucesor=n+1",
          "dificultad": "facil"
        }
      ],
      "test_templates": [
        {
          "tipo": "test_opcion_multiple",
          "enunciado": "¿Cuántas centenas hay en el número {n}?",
          "variables": {
            "n": { "tipo": "numero", "min": 100, "max": 9999 }
          },
          "opciones_generacion": "calcular_centenas(n) y 3 distractores cercanos",
          "respuesta": "floor(n/100)",
          "dificultad": "medio"
        },
        {
          "tipo": "test_verdadero_falso",
          "enunciado": "{a} es mayor que {b}. ¿Verdadero o falso?",
          "variables": {
            "a": { "tipo": "numero", "min": 1000, "max": 99999 },
            "b": { "tipo": "numero", "min": 1000, "max": 99999 }
          },
          "respuesta": "a > b",
          "dificultad": "facil"
        }
      ],
      "actividades_templates": [
        {
          "tipo": "problema_contexto",
          "enunciado": "En una ciudad viven {a} personas. En otra ciudad viven {b} personas. ¿Cuántas personas viven en total en las dos ciudades?",
          "variables": {
            "a": { "tipo": "numero", "min": 10000, "max": 99999 },
            "b": { "tipo": "numero", "min": 10000, "max": 99999 }
          },
          "respuesta": "a + b",
          "dificultad": "facil"
        }
      ],
      "fichas_templates": [
        {
          "tipo": "ficha_tabla_valor_posicional",
          "descripcion": "Tabla para rellenar con el valor posicional de un número dado",
          "variables": { "n": { "tipo": "numero", "min": 10000, "max": 999999 } }
        }
      ]
    },
    {
      "id_unidad": "mat_02",
      "numero": 2,
      "titulo": "Suma y resta de números grandes",
      "resumen": "Practicamos la suma y la resta con números de hasta 6 cifras, incluyendo llevadas y préstamos. Resolvemos problemas de la vida cotidiana usando estas operaciones.",
      "resumen_simple": "Aprenderemos a sumar y restar números grandes, como los que usamos cuando contamos el dinero o las distancias. ¡Con práctica se vuelve muy fácil!",
      "conceptos_clave": ["suma con llevadas", "resta con préstamo", "comprobación de resultados", "problemas de suma y resta"],
      "habilidades": ["sumar números de hasta 6 cifras", "restar con préstamo", "comprobar operaciones", "resolver problemas"],
      "repaso_clave": [
        "En la suma, sumamos de derecha a izquierda",
        "Si la suma supera 9, llevamos una a la siguiente columna",
        "La resta se comprueba sumando el resultado + el sustraendo",
        "En la resta con préstamo, tomamos una decena prestada"
      ],
      "ejercicios_templates": [
        {
          "tipo": "suma",
          "enunciado": "Calcula: {a} + {b}",
          "variables": {
            "a": { "tipo": "numero", "min": 1000, "max": 99999 },
            "b": { "tipo": "numero", "min": 1000, "max": 99999 }
          },
          "respuesta": "a + b",
          "dificultad": "facil"
        },
        {
          "tipo": "suma_tres_sumandos",
          "enunciado": "Calcula: {a} + {b} + {c}",
          "variables": {
            "a": { "tipo": "numero", "min": 1000, "max": 49999 },
            "b": { "tipo": "numero", "min": 1000, "max": 49999 },
            "c": { "tipo": "numero", "min": 1000, "max": 49999 }
          },
          "respuesta": "a + b + c",
          "dificultad": "medio"
        },
        {
          "tipo": "resta",
          "enunciado": "Calcula: {a} - {b}",
          "variables": {
            "a": { "tipo": "numero", "min": 10000, "max": 99999 },
            "b": { "tipo": "numero", "min": 1000, "max": "a" }
          },
          "respuesta": "a - b",
          "dificultad": "facil"
        },
        {
          "tipo": "suma_con_huecos",
          "enunciado": "{a} + ___ = {resultado}",
          "variables": {
            "a": { "tipo": "numero", "min": 1000, "max": 49999 },
            "b": { "tipo": "numero", "min": 1000, "max": 49999 }
          },
          "resultado_calculo": "a + b",
          "respuesta": "b",
          "dificultad": "medio"
        },
        {
          "tipo": "problema_suma_resta",
          "enunciado": "En una librería había {a} libros. Vendieron {b} y llegaron {c} nuevos. ¿Cuántos libros hay ahora?",
          "variables": {
            "a": { "tipo": "numero", "min": 5000, "max": 20000 },
            "b": { "tipo": "numero", "min": 500, "max": 3000 },
            "c": { "tipo": "numero", "min": 200, "max": 2000 }
          },
          "respuesta": "a - b + c",
          "dificultad": "dificil"
        },
        {
          "tipo": "comprobacion_resta",
          "enunciado": "Comprueba si esta resta es correcta: {a} - {b} = {resultado_propuesto}",
          "variables": {
            "a": { "tipo": "numero", "min": 10000, "max": 99999 },
            "b": { "tipo": "numero", "min": 1000, "max": 9999 },
            "error": { "tipo": "booleano" }
          },
          "respuesta": "verificar_resta(a, b, resultado_propuesto)",
          "dificultad": "dificil"
        }
      ],
      "test_templates": [
        {
          "tipo": "test_resultado_correcto",
          "enunciado": "¿Cuánto es {a} + {b}?",
          "variables": {
            "a": { "tipo": "numero", "min": 1000, "max": 9999 },
            "b": { "tipo": "numero", "min": 1000, "max": 9999 }
          },
          "respuesta": "a + b",
          "dificultad": "facil"
        }
      ],
      "actividades_templates": [
        {
          "tipo": "problema_dinero",
          "enunciado": "Papá tiene {a} euros. Gasta {b} euros en la compra y {c} euros en gasolina. ¿Cuánto dinero le queda?",
          "variables": {
            "a": { "tipo": "numero", "min": 500, "max": 2000 },
            "b": { "tipo": "numero", "min": 50, "max": 300 },
            "c": { "tipo": "numero", "min": 20, "max": 100 }
          },
          "respuesta": "a - b - c",
          "dificultad": "medio"
        }
      ],
      "fichas_templates": [
        {
          "tipo": "ficha_operaciones_verticales",
          "descripcion": "Cuadrícula con 8 operaciones de suma y resta para resolver verticalmente",
          "variables": {}
        }
      ]
    },
    {
