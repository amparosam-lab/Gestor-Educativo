        { "ingles": "went", "español": "fue / fui (pasado de go)" },
        { "ingles": "had", "español": "tuvo / tuve (pasado de have)" },
        { "ingles": "saw", "español": "vio / vi (pasado de see)" },
        { "ingles": "ate", "español": "comió / comí (pasado de eat)" },
        { "ingles": "came", "español": "vino / vine (pasado de come)" },
        { "ingles": "ran", "español": "corrió / corrí (pasado de run)" },
        { "ingles": "played", "español": "jugó / jugué (pasado de play)" },
        { "ingles": "walked", "español": "caminó / caminé (pasado de walk)" },
        { "ingles": "visited", "español": "visitó / visité (pasado de visit)" },
        { "ingles": "watched", "español": "vio / vi en TV (pasado de watch)" }
      ],
      "expresiones": [
        "Once upon a time there was/were...",
        "Yesterday I went to...",
        "Last week she played...",
        "Two days ago we had...",
        "Did you go to school yesterday? → Yes, I did. / No, I didn't.",
        "What did you do last weekend?"
      ],
      "ejercicios_templates": [
        {
          "tipo": "past_simple_regular",
          "enunciado": "Write the past simple of: '{verbo}'",
          "variables": {
            "verbo": { "tipo": "lista", "opciones": ["play", "walk", "watch", "visit", "jump", "dance", "clean", "cook", "help", "talk"] }
          },
          "respuesta": "Ver corrección manual",
          "dificultad": "facil"
        },
        {
          "tipo": "past_simple_irregular",
          "enunciado": "Write the past simple of: '{verbo}'",
