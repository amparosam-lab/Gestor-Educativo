          },
          "respuesta_esperada": [
            "She didn't go to the park.",
            "They didn't play football.",
            "He didn't eat a pizza.",
            "I didn't watch TV yesterday."
          ],
          "dificultad": "medio"
        },
        {
          "tipo": "traduccion_pasado",
          "enunciado": "Translate: '{frase_es}'",
          "variables": {
            "frase_es": { "tipo": "lista", "opciones": [
