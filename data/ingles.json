          },
          "respuesta_esperada": ["went", "had", "saw", "ate", "came", "ran", "made", "took", "got", "gave"],
          "dificultad": "medio"
        },
        {
          "tipo": "negativa_pasado",
          "enunciado": "Make it negative: '{oracion_positiva}'",
          "variables": {
            "oracion_positiva": { "tipo": "lista", "opciones": [
              "She went to the park.",
