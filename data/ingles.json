    {
      "id_unidad": "ing_03",
      "numero": 3,
      "titulo": "Let's tell stories!",
      "resumen": "Aprendemos el pasado simple de los verbos regulares e irregulares más comunes. Contamos historias en pasado usando expresiones de tiempo (yesterday, last week, ago).",
      "resumen_simple": "El pasado simple nos ayuda a contar historias de cosas que ya ocurrieron. Los verbos regulares añaden -ed (played, walked) y los irregulares cambian de forma (go→went, have→had).",
      "conceptos_clave": ["past simple regular", "past simple irregular", "time expressions", "yesterday", "last week/month/year", "ago", "was/were", "negative form: didn't", "question form: Did...?"],
      "habilidades": ["formar el pasado simple regular", "usar verbos irregulares comunes", "hacer preguntas en pasado", "contar una historia en pasado"],
      "repaso_clave": [
        "Regular verbs: + ed → play→played, walk→walked, dance→danced",
        "Irregular verbs: go→went, have→had, see→saw, eat→ate, come→came",
        "Negative: didn't + infinitive → I didn't go.",
        "Question: Did + subject + infinitive? → Did you go?",
        "was (singular) / were (plural)"
      ],
      "vocabulario": [
        { "ingles": "yesterday", "español": "ayer" },
        { "ingles": "last week", "español": "la semana pasada" },
        { "ingles": "last month", "español": "el mes pasado" },
        { "ingles": "last year", "español": "el año pasado" },
