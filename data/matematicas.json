    {
      "id_unidad": "mat_04",
      "numero": 4,
      "titulo": "Residuos cero",
      "resumen": "Aprendemos la división de números de varias cifras entre un número de una cifra. Trabajamos los términos de la división, la división exacta e inexacta y la prueba de la división.",
      "resumen_simple": "Dividir es repartir en partes iguales. Aprendemos a dividir números grandes entre un número de una cifra, a calcular el resto y a comprobar el resultado.",
      "conceptos_clave": ["dividendo", "divisor", "cociente", "resto", "división exacta", "división inexacta", "prueba de la división", "operaciones combinadas"],
      "habilidades": ["dividir entre una cifra", "calcular cociente y resto", "comprobar la división", "resolver problemas de reparto"],
      "repaso_clave": [
        "División exacta: el resto es 0",
        "División inexacta: el resto es mayor que 0",
        "El resto siempre es menor que el divisor",
        "Prueba: cociente × divisor + resto = dividendo",
        "Dividendo = Divisor × Cociente + Resto"
      ],
      "ejercicios_templates": [
        {
          "tipo": "division_exacta",
          "enunciado": "Calcula: {a} ÷ {b} =",
          "variables": {
            "b": { "tipo": "numero", "min": 2, "max": 9 },
            "cociente": { "tipo": "numero", "min": 10, "max": 999 }
          },
          "a_calculo": "b * cociente",
          "respuesta": "cociente",
          "dificultad": "facil"
        },
        {
          "tipo": "division_con_resto",
          "enunciado": "Calcula y escribe el cociente y el resto: {a} ÷ {b}",
          "variables": {
            "a": { "tipo": "numero", "min": 100, "max": 9999 },
            "b": { "tipo": "numero", "min": 2, "max": 9 }
          },
          "respuesta": "cociente=floor(a/b), resto=a%b",
          "dificultad": "medio"
        },
        {
          "tipo": "prueba_division",
          "enunciado": "Comprueba esta división usando la prueba: {a} ÷ {b} = {c} (resto {r}). ¿Es correcta? Escribe Sí o No.",
          "variables": {
            "b": { "tipo": "numero", "min": 2, "max": 9 },
            "c": { "tipo": "numero", "min": 10, "max": 99 },
            "r": { "tipo": "numero", "min": 1, "max": 8 }
          },
          "a_calculo": "b * c + r",
          "respuesta": "Sí",
          "dificultad": "dificil"
        },
        {
          "tipo": "problema_reparto",
          "enunciado": "Hay {a} kg de residuos para repartir en {b} contenedores iguales. ¿Cuántos kg van en cada contenedor? ¿Sobra algo?",
          "variables": {
            "a": { "tipo": "numero", "min": 50, "max": 999 },
            "b": { "tipo": "numero", "min": 2, "max": 9 }
          },
          "respuesta": "cociente=floor(a/b), resto=a%b",
          "dificultad": "medio"
        }
      ],
      "test_templates": [
