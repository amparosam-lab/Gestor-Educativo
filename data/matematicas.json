      "resumen_simple": "Multiplicamos números grandes por una o dos cifras. También aprendemos a multiplicar por 10, 100 y 1000 de forma rápida, ¡añadiendo ceros!",
      "conceptos_clave": ["multiplicación por una cifra", "multiplicación por dos cifras", "multiplicación por 10, 100, 1000", "propiedad conmutativa", "propiedad distributiva", "estimación del producto"],
      "habilidades": ["multiplicar por una cifra", "multiplicar por dos cifras", "multiplicar por decenas y centenas", "estimar productos", "resolver problemas de multiplicación"],
      "repaso_clave": [
        "Para multiplicar por 10 añadimos un cero",
        "Para multiplicar por 100 añadimos dos ceros",
