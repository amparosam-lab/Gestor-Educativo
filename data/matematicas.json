  "unidades": [
    {
      "id_unidad": "mat_01",
      "numero": 1,
      "titulo": "Números en el barrio",
      "resumen": "Leemos, escribimos y comparamos números hasta el millón. Trabajamos el valor posicional de cada cifra, la descomposición numérica y el redondeo.",
      "resumen_simple": "Aprendemos a leer y escribir números muy grandes, ¡hasta un millón! También aprendemos cuánto vale cada cifra según su posición.",
      "conceptos_clave": ["números hasta el millón", "valor posicional", "centenas de millar", "decenas de millar", "unidades de millar", "descomposición", "comparar números", "redondeo"],
      "habilidades": ["leer y escribir números hasta el millón", "comparar y ordenar números", "descomponer números", "redondear a la decena, centena y millar"],
      "repaso_clave": [
        "Un millón = 1.000.000",
        "Orden de posiciones: U · D · C · Um · Dm · Cm",
        "Para comparar, empieza por la cifra de mayor valor posicional",
        "Redondear a la decena: miramos las unidades",
        "La descomposición separa cada cifra según su valor"
      ],
      "ejercicios_templates": [
        {
          "tipo": "comparacion",
          "enunciado": "Escribe > , < o = entre estos números: {a} ___ {b}",
          "variables": {
            "a": { "tipo": "numero", "min": 10000, "max": 999999 },
            "b": { "tipo": "numero", "min": 10000, "max": 999999 }
          },
          "respuesta": "a > b ? '>' : a < b ? '<' : '='",
          "dificultad": "facil"
        },
        {
          "tipo": "descomposicion",
          "enunciado": "Descompón el número {n} según el valor posicional de cada cifra.",
          "variables": {
            "n": { "tipo": "numero", "min": 10000, "max": 99999 }
          },
          "respuesta": "descomponer(n)",
          "dificultad": "facil"
        },
        {
          "tipo": "ordenar_numeros",
          "enunciado": "Ordena de menor a mayor: {a} - {b} - {c} - {d}",
          "variables": {
            "a": { "tipo": "numero", "min": 10000, "max": 999999 },
            "b": { "tipo": "numero", "min": 10000, "max": 999999 },
            "c": { "tipo": "numero", "min": 10000, "max": 999999 },
            "d": { "tipo": "numero", "min": 10000, "max": 999999 }
          },
          "respuesta": "ordenar([a,b,c,d])",
          "dificultad": "medio"
        },
        {
          "tipo": "redondeo_millar",
          "enunciado": "Redondea {n} al millar más cercano.",
          "variables": {
            "n": { "tipo": "numero", "min": 1001, "max": 99999 }
          },
          "respuesta": "Math.round(n/1000)*1000",
          "dificultad": "medio"
        },
        {
          "tipo": "redondeo_centena",
          "enunciado": "Redondea {n} a la centena más cercana.",
          "variables": {
            "n": { "tipo": "numero", "min": 101, "max": 9999 }
          },
          "respuesta": "Math.round(n/100)*100",
          "dificultad": "facil"
        },
        {
          "tipo": "antecesor_sucesor",
          "enunciado": "Escribe el antecesor y el sucesor de {n}.",
          "variables": {
            "n": { "tipo": "numero", "min": 10001, "max": 999998 }
          },
          "respuesta": "antecesor=n-1, sucesor=n+1",
          "dificultad": "facil"
        }
      ],
      "test_templates": [
        {
          "tipo": "test_mayor_menor",
          "enunciado": "¿Cuál de estos números es el mayor?",
          "variables": {
            "a": { "tipo": "numero", "min": 10000, "max": 99999 },
            "b": { "tipo": "numero", "min": 10000, "max": 99999 },
            "c": { "tipo": "numero", "min": 10000, "max": 99999 }
          },
          "respuesta": "Math.max(a,b,c)",
          "dificultad": "facil"
        },
        {
          "tipo": "test_redondeo",
          "enunciado": "¿Cuánto es {n} redondeado a la centena?",
          "variables": {
            "n": { "tipo": "numero", "min": 1050, "max": 9950 }
          },
          "respuesta": "Math.round(n/100)*100",
          "dificultad": "medio"
        }
      ],
      "actividades_templates": [
        {
          "tipo": "problema_poblacion",
          "enunciado": "En el barrio A viven {a} personas y en el barrio B viven {b} personas. ¿Cuántas personas viven en total? ¿Cuántas más viven en el barrio mayor?",
          "variables": {
            "a": { "tipo": "numero", "min": 10000, "max": 99999 },
            "b": { "tipo": "numero", "min": 10000, "max": 99999 }
          },
          "respuesta": "Ver corrección manual",
          "dificultad": "medio"
        }
      ],
      "fichas_templates": []
    },
    {
      "id_unidad": "mat_02",
      "numero": 2,
      "titulo": "Juntos sumamos",
      "resumen": "Practicamos la suma y la resta con números de hasta 6 cifras, incluyendo llevadas y préstamos. Trabajamos la propiedad conmutativa y asociativa de la suma.",
      "resumen_simple": "Sumamos y restamos números grandes. Aprendemos que el orden de los sumandos no cambia el resultado, ¡y practicamos muchos problemas!",
      "conceptos_clave": ["suma con llevadas", "resta con préstamo", "propiedad conmutativa", "propiedad asociativa", "comprobación", "operaciones combinadas"],
      "habilidades": ["sumar números de hasta 6 cifras", "restar con préstamo", "aplicar propiedades de la suma", "comprobar resultados", "resolver problemas"],
      "repaso_clave": [
        "Propiedad conmutativa: a + b = b + a",
        "Propiedad asociativa: (a+b)+c = a+(b+c)",
        "Comprueba la resta: resultado + sustraendo = minuendo",
        "En la suma con llevadas, agrupamos de 10 en 10"
      ],
      "ejercicios_templates": [
        {
          "tipo": "suma",
          "enunciado": "Calcula: {a} + {b}",
          "variables": {
            "a": { "tipo": "numero", "min": 10000, "max": 99999 },
            "b": { "tipo": "numero", "min": 10000, "max": 99999 }
          },
          "respuesta": "a + b",
          "dificultad": "facil"
        },
        {
          "tipo": "suma_tres",
          "enunciado": "Calcula: {a} + {b} + {c}",
          "variables": {
            "a": { "tipo": "numero", "min": 1000, "max": 49999 },
            "b": { "tipo": "numero", "min": 1000, "max": 49999 },
            "c": { "tipo": "numero", "min": 1000, "max": 49999 }
          },
          "respuesta": "a + b + c",
          "dificultad": "medio"
        },
        {
          "tipo": "resta",
          "enunciado": "Calcula: {a} - {b}",
          "variables": {
            "b": { "tipo": "numero", "min": 1000, "max": 49999 },
            "a": { "tipo": "numero", "min": 50000, "max": 99999 }
          },
          "respuesta": "a - b",
          "dificultad": "facil"
        },
        {
          "tipo": "termino_desconocido",
          "enunciado": "{a} + ___ = {resultado}",
          "variables": {
            "a": { "tipo": "numero", "min": 1000, "max": 49999 },
            "b": { "tipo": "numero", "min": 1000, "max": 49999 }
          },
          "resultado_calculo": "a + b",
          "respuesta": "b",
          "dificultad": "medio"
        },
        {
          "tipo": "problema_suma_resta",
          "enunciado": "En un estadio hay {a} espectadores. Se van {b} y llegan {c} nuevos. ¿Cuántos espectadores hay ahora?",
          "variables": {
            "a": { "tipo": "numero", "min": 20000, "max": 80000 },
            "b": { "tipo": "numero", "min": 1000, "max": 10000 },
            "c": { "tipo": "numero", "min": 500, "max": 5000 }
          },
          "respuesta": "a - b + c",
          "dificultad": "dificil"
        }
      ],
      "test_templates": [
        {
          "tipo": "test_suma",
          "enunciado": "¿Cuánto es {a} + {b}?",
          "variables": {
            "a": { "tipo": "numero", "min": 1000, "max": 9999 },
            "b": { "tipo": "numero", "min": 1000, "max": 9999 }
          },
          "respuesta": "a + b",
          "dificultad": "facil"
        },
        {
          "tipo": "test_resta",
          "enunciado": "¿Cuánto es {a} - {b}?",
          "variables": {
            "a": { "tipo": "numero", "min": 5000, "max": 9999 },
            "b": { "tipo": "numero", "min": 1000, "max": 4999 }
          },
          "respuesta": "a - b",
          "dificultad": "facil"
        }
      ],
      "actividades_templates": [
        {
          "tipo": "problema_dinero",
          "enunciado": "Una familia tiene {a} euros ahorrados. Gasta {b} euros en vacaciones y {c} euros en la vuelta al cole. ¿Cuánto dinero le queda?",
          "variables": {
            "a": { "tipo": "numero", "min": 3000, "max": 9999 },
            "b": { "tipo": "numero", "min": 500, "max": 2000 },
            "c": { "tipo": "numero", "min": 200, "max": 800 }
          },
          "respuesta": "a - b - c",
          "dificultad": "medio"
        }
      ],
      "fichas_templates": []
    },
